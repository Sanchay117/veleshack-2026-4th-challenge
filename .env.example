# Copy to .env and set TEAM_NAME. That is the only value you must change.
#
#     cp .env.example .env
#
# Your device profile - preference weights, floors, battery, mobility - is
# derived deterministically from TEAM_NAME, so it stays the same across every
# run you do and differs from every other team's. Pick a name and keep it.

TEAM_NAME=NullPointerException

# Which scenario the arena runs.
#   practice  fast rounds, no injected faults - develop against this
#   graded    shorter windows, 60 rounds, 503s and latency - rehearse on this
SCENARIO=practice

# Host port for the arena. Change it if 8080 is already taken, or to run two
# arenas side by side.
ARENA_PORT=8080

# DEBUG on your own agent is useful; the bots are quiet on purpose.
LOG_LEVEL=INFO

# Leave empty. The organisers inject the real seed at grading time; your agent
# must work on any seed.
ARENA_SEED=
